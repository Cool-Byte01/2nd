				<title>Dnscrypt</title>
				<link>http://localhost:1313/posts/notes/dnscrypt/</link>
				<pubDate>Mon, 28 Sep 2026 23:26:33 +0700</pubDate>
				<guid>http://localhost:1313/posts/notes/dnscrypt/</guid>
				<description>&lt;h2 id=&#34;insall-dnscrypt-proxy&#34;&gt;Insall DNSCrypt-proxy&lt;a class=&#34;heading-anchor&#34; href=&#34;#insall-dnscrypt-proxy&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&#xA;&lt;div class=&#34;code&#34;&gt;&#xA;  &lt;div class=&#34;code__bar&#34;&gt;&#xA;    &lt;span&gt;shell&lt;/span&gt;&#xA;    &lt;button class=&#34;code__copy&#34; type=&#34;button&#34; data-nuno-copy aria-label=&#34;Copy code to clipboard&#34;&gt;Copy&lt;/button&gt;&#xA;  &lt;/div&gt;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;&#34;&gt;&lt;code class=&#34;language-shell&#34; data-lang=&#34;shell&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;sudo pacman -S dnscrypt-proxy&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&#xA;&lt;h2 id=&#34;konfigurasi&#34;&gt;Konfigurasi&lt;a class=&#34;heading-anchor&#34; href=&#34;#konfigurasi&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&#xA;&lt;div class=&#34;code&#34;&gt;&#xA;  &lt;div class=&#34;code__bar&#34;&gt;&#xA;    &lt;span&gt;shell&lt;/span&gt;&#xA;    &lt;button class=&#34;code__copy&#34; type=&#34;button&#34; data-nuno-copy aria-label=&#34;Copy code to clipboard&#34;&gt;Copy&lt;/button&gt;&#xA;  &lt;/div&gt;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;&#34;&gt;&lt;code class=&#34;language-shell&#34; data-lang=&#34;shell&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;sudo nvim /etc/dnscrypt-proxy/dnscrypt-proxy.toml&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&#xA;&lt;h3 id=&#34;ubah-listen-addresses&#34;&gt;Ubah Listen Addresses&lt;a class=&#34;heading-anchor&#34; href=&#34;#ubah-listen-addresses&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;/a&gt;&lt;/h3&gt;&#xA;&lt;div class=&#34;code&#34;&gt;&#xA;  &lt;div class=&#34;code__bar&#34;&gt;&#xA;    &lt;span&gt;toml&lt;/span&gt;&#xA;    &lt;button class=&#34;code__copy&#34; type=&#34;button&#34; data-nuno-copy aria-label=&#34;Copy code to clipboard&#34;&gt;Copy&lt;/button&gt;&#xA;  &lt;/div&gt;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;&#34;&gt;&lt;code class=&#34;language-toml&#34; data-lang=&#34;toml&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;&lt;span style=&#34;color:#a6e22e&#34;&gt;listen_addresses&lt;/span&gt; = [&lt;span style=&#34;color:#e6db74&#34;&gt;&amp;#39;127.0.0.1:53&amp;#39;&lt;/span&gt;, &lt;span style=&#34;color:#e6db74&#34;&gt;&amp;#39;[::1]:53&amp;#39;&lt;/span&gt;]&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&#xA;&lt;h3 id=&#34;pilih-server-dns&#34;&gt;Pilih Server DNS&lt;a class=&#34;heading-anchor&#34; href=&#34;#pilih-server-dns&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;/a&gt;&lt;/h3&gt;&#xA;&lt;div class=&#34;code&#34;&gt;&#xA;  &lt;div class=&#34;code__bar&#34;&gt;&#xA;    &lt;span&gt;toml&lt;/span&gt;&#xA;    &lt;button class=&#34;code__copy&#34; type=&#34;button&#34; data-nuno-copy aria-label=&#34;Copy code to clipboard&#34;&gt;Copy&lt;/button&gt;&#xA;  &lt;/div&gt;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;&#34;&gt;&lt;code class=&#34;language-toml&#34; data-lang=&#34;toml&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;&lt;span style=&#34;color:#a6e22e&#34;&gt;server_names&lt;/span&gt; = [&lt;span style=&#34;color:#e6db74&#34;&gt;&amp;#39;cloudflare&amp;#39;&lt;/span&gt;, &lt;span style=&#34;color:#e6db74&#34;&gt;&amp;#39;cloudflare-ipv6&amp;#39;&lt;/span&gt;]&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&#xA;&lt;h3 id=&#34;&#34;&gt;&lt;a class=&#34;heading-anchor&#34; href=&#34;#&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;/a&gt;&lt;/h3&gt;&#xA;&lt;div class=&#34;code&#34;&gt;&#xA;  &lt;div class=&#34;code__bar&#34;&gt;&#xA;    &lt;span&gt;toml&lt;/span&gt;&#xA;    &lt;button class=&#34;code__copy&#34; type=&#34;button&#34; data-nuno-copy aria-label=&#34;Copy code to clipboard&#34;&gt;Copy&lt;/button&gt;&#xA;  &lt;/div&gt;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;&#34;&gt;&lt;code class=&#34;language-toml&#34; data-lang=&#34;toml&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;&lt;span style=&#34;color:#a6e22e&#34;&gt;lb_strategy&lt;/span&gt; = &lt;span style=&#34;color:#e6db74&#34;&gt;&amp;#39;p2&amp;#39;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&#xA;&lt;h3 id=&#34;&#34;&gt;&lt;a class=&#34;heading-anchor&#34; href=&#34;#&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;/a&gt;&lt;/h3&gt;&#xA;&lt;div class=&#34;code&#34;&gt;&#xA;  &lt;div class=&#34;code__bar&#34;&gt;&#xA;    &lt;span&gt;toml&lt;/span&gt;&#xA;    &lt;button class=&#34;code__copy&#34; type=&#34;button&#34; data-nuno-copy aria-label=&#34;Copy code to clipboard&#34;&gt;Copy&lt;/button&gt;&#xA;  &lt;/div&gt;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;&#34;&gt;&lt;code class=&#34;language-toml&#34; data-lang=&#34;toml&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;&lt;span style=&#34;color:#a6e22e&#34;&gt;require_dnssec&lt;/span&gt; = &lt;span style=&#34;color:#66d9ef&#34;&gt;true&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&#xA;&lt;h2 id=&#34;konfigurasi-dns-resolver-sistem&#34;&gt;Konfigurasi DNS Resolver Sistem&lt;a class=&#34;heading-anchor&#34; href=&#34;#konfigurasi-dns-resolver-sistem&#34; aria-label=&#34;Link to this section&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&#xA;&lt;div class=&#34;code&#34;&gt;&#xA;  &lt;div class=&#34;code__bar&#34;&gt;&#xA;    &lt;span&gt;shell&lt;/span&gt;&#xA;    &lt;button class=&#34;code__copy&#34; type=&#34;button&#34; data-nuno-copy aria-label=&#34;Copy code to clipboard&#34;&gt;Copy&lt;/button&gt;&#xA;  &lt;/div&gt;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;&#34;&gt;&lt;code class=&#34;language-shell&#34; data-lang=&#34;shell&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;sudo nvim /etc/resolv.conf&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&#xA;&lt;p&gt;Tambahkan&lt;/p&gt;</description>
			</item>
